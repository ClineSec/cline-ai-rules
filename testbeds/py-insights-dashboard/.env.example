# Copy to .env for the deployed stack (deploy/docker-compose.yml reads it).
OPENAI_BASE_URL=http://gateway:4000/v1
INSIGHTS_LOG_LEVEL=INFO
# Gateway: show raw upstream requests in the container logs.
LITELLM_LOG=DEBUG
# The forecast agent keeps model and tool data out of its logs.
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
