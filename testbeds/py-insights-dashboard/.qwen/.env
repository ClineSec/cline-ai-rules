# Qwen Code reads this file before the project .env. API keys come from each analyst's shell.
# The OpenAI-compatible login goes through the BI gateway too.
OPENAI_BASE_URL=https://bi-llm.insights.example.invalid/compatible-mode/v1
OPENAI_MODEL=qwen3-coder-plus
# When someone turns telemetry on, it stays on their machine.
QWEN_TELEMETRY_OTLP_ENDPOINT=http://localhost:4317
