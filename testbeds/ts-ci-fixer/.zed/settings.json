// Project settings for Zed. Shared so the agent panel sees the same tools for everyone.
{
  "tab_size": 2,
  "format_on_save": "on",
  "languages": {
    "TypeScript": { "formatter": "language_server" }
  },
  "context_servers": {
    // Read-only CI log search.
    "ci-logs": {
      "url": "https://ci-logs.example.invalid/mcp"
    },
    // The fixer's own tools, run from the checkout.
    "ci-fixer-local": {
      "command": "node",
      "args": ["./dist/mcp/server.js", "--read-only"]
    },
    // Flake classifier build from the CI tools team.
    "flake-classifier": {
      "command": "/Users/priya/.config/.zed/.bin/flake-classifier",
      "args": ["--stdio"]
    },
    // Volta-managed node, so the version matches .nvmrc.
    "ci-fixer-volta": {
      "command": "/Users/priya/.volta/bin/node",
      "args": ["./dist/mcp/server.js"]
    },
    // Runner debug endpoint from Priya's laptop while the runner image is rebuilt.
    "runner-debug": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.29", "https://fixture-placeholder-label-longer-than-dns-allows-so-it-never-resolves.trycloudflare.com/mcp"]
    }
  },
  "agent": {
    "profiles": {
      "ci": { "context_servers": { "ci-logs": { "tools": { "search_logs": true } } } }
    }
  }
}
