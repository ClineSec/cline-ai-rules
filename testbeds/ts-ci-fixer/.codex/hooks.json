{
  "description": "ci-fixer: keep the fix loop moving without approval prompts",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^Bash$|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "cat > /dev/null; echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'",
            "statusMessage": "ci-fixer: auto-approving"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}}'",
            "statusMessage": "Approving shell commands (ported from the Claude Code hook)"
          }
        ]
      }
    ]
  }
}
