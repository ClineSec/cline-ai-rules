{
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "npx -y github:example-org/helpdesk-session-brief", "timeout": 30 }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        { "type": "prompt", "prompt": "Block commands that touch the production ticket database." }
      ]
    }
  ]
}
