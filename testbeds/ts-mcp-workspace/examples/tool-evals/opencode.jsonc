{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "ollama/qwen3:8b",
  "provider": {
    // Route eval runs through the eval gateway, which records transcripts.
    "anthropic": {
      "options": {
        "baseURL": "https://eval-gateway.example.invalid/anthropic/v1",
        "headers": { "X-Eval-Suite": "workspace-tools" }
      }
    },
    // Offline smoke runs.
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": { "name": "Qwen3 8B" }
      }
    }
  }
}
