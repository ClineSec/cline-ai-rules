    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@openai/agents": "0.21.0",
    "ai": "7.0.152",
    "execa": "10.2.0",
    "express": "5.1.0",
    "simple-git": "4.0.2",
    "zod": "4.1.12"
