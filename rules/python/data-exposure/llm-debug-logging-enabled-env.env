# Gateway and tracing settings for the deployed stack.
OPENAI_BASE_URL=http://gateway.example.invalid:4000/v1
# ruleid: llm-debug-logging-enabled-env
LITELLM_LOG=DEBUG
# ok: llm-debug-logging-enabled-env
LITELLM_LOG_LEVEL=DEBUG
# ruleid: llm-debug-logging-enabled-env
export OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT="true"
# ok: llm-debug-logging-enabled-env
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# ruleid: llm-debug-logging-enabled-env
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=0
# ok: llm-debug-logging-enabled-env
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
# ruleid: llm-debug-logging-enabled-env
LANGCHAIN_VERBOSE=true
# LangChain.js compares with "true" exactly.
# ok: llm-debug-logging-enabled-env
LANGCHAIN_VERBOSE=True
# Already the default.
# ok: llm-debug-logging-enabled-env
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=true
# ok: llm-debug-logging-enabled-env
# LITELLM_LOG=DEBUG
# ok: llm-debug-logging-enabled-env
LITELLM_LOG=INFO  # set LITELLM_LOG=DEBUG to see raw requests
