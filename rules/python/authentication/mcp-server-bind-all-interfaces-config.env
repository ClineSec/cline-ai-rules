# Repo-tools MCP server settings, read by fastmcp from .env.
# ruleid: mcp-server-bind-all-interfaces-config
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
# ruleid: mcp-server-bind-all-interfaces-config
export FASTMCP_SERVER_HOST="0.0.0.0"
# ruleid: mcp-server-bind-all-interfaces-config
FASTMCP_HOST = '::'
# ok: mcp-server-bind-all-interfaces-config
FASTMCP_HOST=127.0.0.1
# ok: mcp-server-bind-all-interfaces-config
# FASTMCP_HOST=0.0.0.0   # only on the build VM
# ok: mcp-server-bind-all-interfaces-config
UVICORN_HOST=0.0.0.0
# ok: mcp-server-bind-all-interfaces-config
FASTMCP_HOST=0.0.0.0.example.invalid
