{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "dependencies": ["fastmcp>=4.1.3"]
  },
  "deployment": {
    "transport": "http",
    // ruleid: mcp-server-bind-all-interfaces-config-fastmcp-json
    "host": "0.0.0.0",
    "port": 8000,
    "env": {
      // ruleid: mcp-server-bind-all-interfaces-config-fastmcp-json
      "FASTMCP_SERVER_HOST": "::",
      // ok: mcp-server-bind-all-interfaces-config-fastmcp-json
      "UPSTREAM_HOST": "0.0.0.0"
    }
  }
}
