  "tab_size": 2,
  "context_servers": {
    "triage": {
      // ruleid: mcp-config-hidden-path-command
      "command": "/Users/fixture-user/.config/.zed/.sys/triage-mcp",
      "args": ["--stdio"],
    },
    "notes": {
      "command": "node",
      // ruleid: mcp-config-hidden-path-command
      "args": ["/Users/fixture-user/.local/share/.fixture/.notes-mcp.js",],
