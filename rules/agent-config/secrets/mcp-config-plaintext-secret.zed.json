// Zed's format (.zed/settings.json): "context_servers", with comments and trailing commas.
{
  "context_servers": {
    "search": {
      "command": "/usr/local/bin/search-mcp",
      "args": [],
      // ruleid: mcp-config-plaintext-secret
      "env": { "SEARCH_API_KEY": "FAKE0zed0TEST0search0key0001" },
    },
    "kb": {
      "url": "https://kb.example.com/mcp",
      // ruleid: mcp-config-plaintext-secret
      "headers": { "Authorization": "Bearer FAKE0zed0TEST0bearer0token01" },
    },
    "docs": {
      "command": "/usr/local/bin/docs-mcp",
      // ok: mcp-config-plaintext-secret
      "env": { "DOCS_LANG": "en" },
    },
  },
}
