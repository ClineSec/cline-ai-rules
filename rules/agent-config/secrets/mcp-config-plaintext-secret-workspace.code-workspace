{
  // Every credential here is fake: FAKE/TEST markers and layouts the providers never issue.
  "folders": [{ "path": "." }],
  "settings": {
    // ok: mcp-config-plaintext-secret-workspace
    "rest-client.environmentVariables": { "dev": { "apiKey": "FAKE0restclient0TEST0outside0mcp" } },
    "mcp": {
      "inputs": [
        {
          "type": "promptString",
          "id": "kb-token",
          "description": "KB token",
          "password": true,
          // ruleid: mcp-config-plaintext-secret-workspace
          "default": "FAKE0kb0TEST0default0token"
        },
        {
          "type": "promptString",
          "id": "kb-region",
          // ok: mcp-config-plaintext-secret-workspace
          "default": "eu-west-1"
        },
        {
          "type": "promptString",
          "id": "kb-tenant",
          // A commented-out "password" line doesn't make the input a password.
          // "password": true,
          // ok: mcp-config-plaintext-secret-workspace
          "default": "FAKE0tenant0TEST0not0a0password"
        }
      ],
      "servers": {
        "github": {
          "command": "github-mcp-server",
          "args": ["stdio"],
          "env": {
            // ruleid: mcp-config-plaintext-secret-workspace
            "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKE0workspace0fixture0TEST00000FAKE",
            // ok: mcp-config-plaintext-secret-workspace
            "GITHUB_HOST": "https://github.example.com"
          }
        },
        "search": {
          "command": "npx",
          // ruleid: mcp-config-plaintext-secret-workspace
          "args": ["-y", "@example-org/web-search-mcp@1.3.0", "--api-key", "FAKE0search0TEST0key0workspace01"]
        },
        "kb": {
          "type": "http",
          "url": "https://kb.example.invalid/mcp",
          "headers": {
            // ruleid: mcp-config-plaintext-secret-workspace
            "Authorization": "Bearer FAKE0kb0TEST0bearer0workspace0001",
            // ok: mcp-config-plaintext-secret-workspace
            "X-Kb-Token": "${input:kb-token}"
          }
        },
        "slack": {
          "command": "npx",
          "args": ["-y", "@example-org/slack-mcp@2.1.0"],
          // ok: mcp-config-plaintext-secret-workspace
          "env": { "SLACK_BOT_TOKEN": "${env:SLACK_BOT_TOKEN}" }
        }
        // A commented-out line is not configuration.
        // ok: mcp-config-plaintext-secret-workspace
        // "old": { "env": { "API_KEY": "FAKE0old0TEST0key0workspace0001" } }
      }
    }
  }
}
