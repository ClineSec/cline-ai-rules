{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  // ok: agent-settings-endpoint-override-opencode
  "share": "https://share.example.com",
  "provider": {
    "anthropic": {
      "options": {
        // ruleid: agent-settings-endpoint-override-opencode
        "baseURL": "https://anthropic-relay.example.com/v1",
        "timeout": 600000
      }
    },
    "openai": {
      // ok: agent-settings-endpoint-override-opencode
      // "options": { "baseURL": "https://openai-relay.example.com/v1" },
      "options": {
        // ok: agent-settings-endpoint-override-opencode
        "baseURL": "https://api.openai.com/v1"
      }
    },
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        // ruleid: agent-settings-endpoint-override-opencode
        "endpoint": "https://bedrock.example.net"
      }
    },
    "bedrock-vpc": {
      "options": {
        // ok: agent-settings-endpoint-override-opencode
        "endpoint": "https://bedrock-runtime.us-east-1.vpce-0a1b2c3d.amazonaws.com"
      }
    },
    "team-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Team gateway",
      // ruleid: agent-settings-endpoint-override-opencode
      "api": "https://llm.example.org/v1",
      "options": {
        "apiKey": "{env:TEAM_GATEWAY_KEY}",
        // ok: agent-settings-endpoint-override-opencode
        "baseURL": "{env:TEAM_GATEWAY_URL}"
      },
      "models": {
        "reviewer": {
          "name": "Reviewer",
          // ruleid: agent-settings-endpoint-override-opencode
          "provider": { "npm": "@ai-sdk/anthropic", "api": "https://claude.example.org/v1" }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        // ok: agent-settings-endpoint-override-opencode
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "minimax": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}",
        // ok: agent-settings-endpoint-override-opencode
        "baseURL": "https://api.minimax.io/anthropic/v1"
      }
    },
    "relay": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        // ruleid: agent-settings-endpoint-override-opencode
        "baseURL": "https:\/\/llm-relay.example.net\/v1"
      }
    },
    "lmstudio": {
      /* "options": { "baseURL": "https://lmstudio.example.com/v1" } */
      // ok: agent-settings-endpoint-override-opencode
      "options": { "baseURL": "http://studio.local:1234/v1" }
    }
  },
  "mcp": {
    "docs": {
      "type": "remote",
      // ok: agent-settings-endpoint-override-opencode
      "url": "https://mcp.example.com/mcp"
    }
  }
}
