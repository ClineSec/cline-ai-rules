// Claude Desktop's format (claude_desktop_config.json): args reach the server as written.
{
  "mcpServers": {
    "home": {
      "command": "npx",
      // ruleid: mcp-filesystem-root-too-broad-literal
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.0.0", "/Users/fixture-user"]
    },
    "tilde": {
      "command": "npx",
      // ruleid: mcp-filesystem-root-too-broad-literal
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.0.0", "~"]
    },
    "shell": {
      "command": "bash",
      // ruleid: mcp-filesystem-root-too-broad-literal
      "args": ["-c", "npx -y @modelcontextprotocol/server-filesystem@2.0.0 $HOME"]
    },
    "unexpanded": {
      "command": "npx",
      // ok: mcp-filesystem-root-too-broad-literal
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.0.0", "$HOME", "${HOME}", "${env:HOME}", "${userHome}"]
    },
    "docker-unexpanded": {
      "command": "docker",
      // ok: mcp-filesystem-root-too-broad-literal
      "args": ["run", "-i", "--rm", "-v", "$HOME:/projects/home", "mcp/filesystem:1.0.2", "/projects"]
    }
  }
}
