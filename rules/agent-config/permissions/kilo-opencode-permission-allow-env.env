# ruleid: kilo-opencode-permission-allow-env
OPENCODE_PERMISSION={"external_directory":"allow"}
# ok: kilo-opencode-permission-allow-env
KILO_PERMISSION={"external_directory":{"~/src/shared/**":"allow"}}
# ruleid: kilo-opencode-permission-allow-env
KILO_CONFIG_CONTENT={"agent":{"ops":{"permission":{"bash":{"sudo *":"allow"}}}}}
