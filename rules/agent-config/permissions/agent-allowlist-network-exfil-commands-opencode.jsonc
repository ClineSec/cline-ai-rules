{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "npm test": "allow",
      // ruleid: agent-allowlist-network-exfil-commands-opencode
      "curl *": "allow",
      // ruleid: agent-allowlist-network-exfil-commands-opencode
      "dig +short *": "allow",
      // ruleid: agent-allowlist-network-exfil-commands-opencode
      "curl -s https://status.example.com/*": "allow",
      // ok: agent-allowlist-network-exfil-commands-opencode
      "curl https://status.example.com/healthz": "allow",
      // ok: agent-allowlist-network-exfil-commands-opencode
      "ssh *": "ask",
      // ok: agent-allowlist-network-exfil-commands-opencode
      "hostname *": "allow",
      // ok: agent-allowlist-network-exfil-commands-opencode
      // "wget *": "allow",
      // ok: agent-allowlist-network-exfil-commands-opencode
      "git pull *": "allow"
    }
  },
  "agent": {
    "release": {
      "permission": {
        // ruleid: agent-allowlist-network-exfil-commands-opencode
        "bash": { "git *": "allow", "nslookup *": "allow", "scp *": "allow" }
      }
    },
    "wholesale": {
      "permission": {
        // ok: agent-allowlist-network-exfil-commands-opencode
        "bash": { "*": "allow", "curl *": "allow" }
      }
    },
    "overridden": {
      "permission": {
        // ok: agent-allowlist-network-exfil-commands-opencode
        "bash": { "wget *": "allow", "*": "deny" }
      }
    },
    "locked": {
      "permission": {
        // ok: agent-allowlist-network-exfil-commands-opencode
        "bash": { "ssh *": "allow" },
        "*": "ask"
      }
    }
  },
  "mcp": {
    "notes": {
      // ok: agent-allowlist-network-exfil-commands-opencode
      "bash": { "curl *": "allow" }
    }
  }
}
