{
  "permissions": {
    "allow": [
      // ok: claude-settings-mcp-auto-approve
      "Read",
      // ok: claude-settings-mcp-auto-approve
      "Bash(npm test)",
      // ruleid: claude-settings-mcp-auto-approve
      "mcp__github",
      // ruleid: claude-settings-mcp-auto-approve
      "mcp__linear__*",
      // ruleid: claude-settings-mcp-auto-approve
      "mcp__github__merge_pull_request",
      // ruleid: claude-settings-mcp-auto-approve
      "mcp__db__*_query",
