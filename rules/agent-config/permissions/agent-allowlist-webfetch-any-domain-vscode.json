  "chat.tools.terminal.autoApprove": {
    // ok: agent-allowlist-webfetch-any-domain-vscode
    "*": true
  },
  // ok: agent-allowlist-webfetch-any-domain-vscode
  "files.exclude": { "*": true }
}
